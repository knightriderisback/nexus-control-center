# ==============================================================================
# PERSONAL ENGINEERING OS (NEXUS) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS.
# ==============================================================================

# Core System
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORRELATION_HEADER=X-Correlation-ID

# Google Cloud Platform Isolation
GCP_PROJECT_ID=personal-engineering-os-2026
GCP_PROJECT_NUMBER=582208055065
GCP_REGION=us-central1
GCP_STRICT_ZERO_COST_GUARD=true
USE_MOCK_SECRETS=true

# Workload Identity Federation
WIF_POOL=github-pool
WIF_PROVIDER=github-provider

# Model Providers (Set API keys or rely on Cloud ADC / Vertex AI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Source Control & CI/CD
GITHUB_OWNER=knightriderisback
GITHUB_TOKEN=

# Deployment Targets
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Alerting & Webhooks
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
