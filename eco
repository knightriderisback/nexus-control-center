        print(f"\n{CYAN}[MISSION RETRY]{RESET} Retrying failed subtasks for mission {mid}...")
        res = api_post(f"/missions/{mid}/retry", {})
        print(f"\n{GREEN}✓ Retry completed (State: {res.get('state')}){RESET}")
    elif sub == "graph" and len(args) > 1:
        mid = args[1]
        g = api_get(f"/missions/{mid}/graph")
