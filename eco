import sys
import json
import urllib.request
import urllib.error

API_BASE = "http://127.0.0.1:8000/api/v1"

# ANSI Terminal Colors
CYAN = "\033[96m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
MAGENTA = "\033[95m"
BOLD = "\033[1m"
RESET = "\033[0m"

import os
OPERATOR_TOKEN = os.getenv("NEXUS_OPERATOR_TOKEN", "nexus-dev-operator-key-2026")

def api_get(endpoint: str):
    url = f"{API_BASE}{endpoint}"
    try:
        headers = {
            "User-Agent": "eco-cli/1.0",
            "Authorization": f"Bearer {OPERATOR_TOKEN}"
        }
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.URLError as e:
        print(f"{RED}[ECO ERROR]{RESET} Cannot connect to Control API at {url}")
        print(f"Details: {e}")
        print(f"{YELLOW}[TIP]{RESET} You can manage the local service with: {BOLD}eco daemon start|status|logs{RESET}")
        sys.exit(1)

def api_post(endpoint: str, payload: dict):
    url = f"{API_BASE}{endpoint}"
    try:
        data = json.dumps(payload).encode()
        headers = {
            "Content-Type": "application/json",
            "User-Agent": "eco-cli/1.0",
            "Authorization": f"Bearer {OPERATOR_TOKEN}"
        }
        req = urllib.request.Request(url, data=data, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.URLError as e:
        print(f"{RED}[ECO ERROR]{RESET} Failed POST {url}: {e}")
        sys.exit(1)

