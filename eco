        if res.get("merge_commit"):
            print(f"Merge Commit: {CYAN}{res.get('merge_commit')}{RESET}")
        if res.get("error"):
            print(f"Notice / Detail: {YELLOW}{res.get('error')}{RESET}")
    elif sub == "review" and len(args) > 1:
