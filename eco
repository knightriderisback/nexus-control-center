def cmd_mission(args):
    print_banner()
    sub = args[0] if len(args) > 0 else "list"
    if sub == "list":
        missions = api_get("/missions")
        print(f"\n{BOLD}{'MISSION ID':<20} {'STATE':<18} {'GOAL':<35} {'CREATED'}{RESET}")
        print("=" * 85)
        for m in missions:
            state = m.get("state", "UNKNOWN")
            scolor = GREEN if state == "COMPLETED" else (YELLOW if state in ["EXECUTING", "DECOMPOSED", "PLANNING", "REMEDIATING", "ARBITRATING"] else (RED if state == "FAILED" else CYAN))
            goal_short = (m.get("goal") or "")[:33]
            print(f"{CYAN}{m.get('mission_id'):<20}{RESET} {scolor}{state:<18}{RESET} {goal_short:<35} {m.get('created_at', '')[:19]}")
    elif sub == "plan":
        goal = " ".join(args[1:]) if len(args) > 1 else "Implement feature with test suite"
        print(f"\n{CYAN}[MISSION PLANNER]{RESET} Decomposing engineering goal: {BOLD}\"{goal}\"{RESET}")
        res = api_post("/missions/plan", {"goal": goal})
        print(f"\n{BOLD}Mission ID:{RESET} {CYAN}{res.get('mission_id')}{RESET}")
        print(f"{BOLD}State:{RESET}      {YELLOW}{res.get('state')}{RESET}")
        print(f"{BOLD}Subtasks ({len(res.get('subtasks', []))}):{RESET}")
        for st in res.get("subtasks", []):
            deps = f" (deps: {', '.join(st.get('dependencies', []))})" if st.get("dependencies") else ""
            print(f"  • [{CYAN}{st.get('subtask_id')}{RESET}] {BOLD}{st.get('title')}{RESET} -> {GREEN}{st.get('assigned_agent')}{RESET}{deps}")
        print(f"\n{BOLD}Execution Levels:{RESET} {res.get('execution_order')}")
        if res.get("state") == "AWAITING_APPROVAL":
            print(f"\n{RED}{BOLD}🛑 [HUMAN APPROVAL REQUIRED]{RESET} (Approval ID: {res.get('approval_id')})")
        else:
            print(f"\nRun mission with: {BOLD}eco mission run \"{goal}\"{RESET}")
    elif sub == "run":
        goal = " ".join(args[1:]) if len(args) > 1 else "Implement feature with test suite"
        print(f"\n{CYAN}[MISSION RUNNER]{RESET} Launching autonomous mission: {BOLD}\"{goal}\"{RESET}")
        res = api_post("/missions/run", {"goal": goal})
        state = res.get("state")
        scolor = GREEN if state == "COMPLETED" else (YELLOW if state == "AWAITING_APPROVAL" else RED)
        print(f"\n{BOLD}Mission ID:{RESET} {CYAN}{res.get('mission_id')}{RESET}")
        print(f"{BOLD}Outcome:{RESET}    {scolor}{state}{RESET}")
        if state == "AWAITING_APPROVAL":
            print(f"\n{RED}{BOLD}🛑 [HUMAN APPROVAL REQUIRED]{RESET}")
            print(f"Approval ID: {CYAN}{res.get('approval_id')}{RESET}")
            print(f"Approve with: {BOLD}eco approvals approve {res.get('approval_id')}{RESET}")
        elif state == "COMPLETED":
            telem = res.get("telemetry", {})
            print(f"\n{GREEN}✓ Mission completed in {telem.get('duration_seconds', 0)}s!{RESET}")
            print(f"Subtasks Verified: {telem.get('completed_subtasks', 0)} | Remediations: {telem.get('remediation_rounds_total', 0)} | FinOps: $0.00")
            if res.get("merge_id"):
                print(f"Merge ID: {CYAN}{res.get('merge_id')}{RESET}")
            print(f"\nView changelog with: {BOLD}eco mission changelog {res.get('mission_id')}{RESET}")
        else:
            print(f"\n{RED}Mission failed: {res.get('error')}{RESET}")
    elif sub == "status" and len(args) > 1:
        mid = args[1]
        m = api_get(f"/missions/{mid}")
        print(f"\n{BOLD}MISSION STATUS: {CYAN}{mid}{RESET}")
