    for e in audit_events[:15]:
        rcolor = GREEN if e.get("risk_level") == "LOW" else (YELLOW if e.get("risk_level") == "MEDIUM" else RED)
        print(f"{e.get('timestamp', '')[:23]:<24} {rcolor}{e.get('risk_level', 'LOW'):<10}{RESET} {e.get('action', '')[:33]:<35} {e.get('actor', '')[:14]:<15}")

def cmd_natural_language(prompt: str):
    print(f"{CYAN}[ECO AI ROUTER]{RESET} Evaluating directive: {BOLD}\"{prompt}\"{RESET}")
    res = api_post("/eco/execute", {"prompt": prompt})
    if res.get("status") == "AWAITING_APPROVAL":
        print(f"\n{RED}{BOLD}🛑 [HUMAN APPROVAL REQUIRED]{RESET}")
        print(f"Risk Tier: {RED}{res.get('risk_level')}{RESET}")
        print(f"Approval Request: {CYAN}{res.get('approval_id')}{RESET}")
        print(f"Directive: {res.get('message')}")
        print(f"\nApprove with: {BOLD}eco approvals approve {res.get('approval_id')}{RESET}")
    else:
        print(f"\n{GREEN}✓ {res.get('result')}{RESET}")

def main():
    if len(sys.argv) < 2:
        cmd_status()
        sys.exit(0)

    subcmd = sys.argv[1]

    if subcmd == "status":
        cmd_status()
    elif subcmd == "projects":
        cmd_projects()
    elif subcmd == "agents":
        cmd_agents()
    elif subcmd == "audit":
        project_id = sys.argv[2] if len(sys.argv) > 2 else "control-center"
        cmd_audit(project_id)
    elif subcmd == "test":
        project_id = sys.argv[2] if len(sys.argv) > 2 else "control-center"
        cmd_test(project_id)
    elif subcmd == "security":
        project_id = sys.argv[2] if len(sys.argv) > 2 else "control-center"
        cmd_security(project_id)
    elif subcmd == "deploy":
        project_id = sys.argv[2] if len(sys.argv) > 2 else "control-center"
        cmd_deploy(project_id)
    elif subcmd == "approvals":
        cmd_approvals(sys.argv[2:])
    elif subcmd == "brief":
        cmd_brief()
    elif subcmd == "cost":
        cmd_cost()
    elif subcmd == "secrets":
        cmd_secrets()
    elif subcmd in ["automations", "jobs"]:
        cmd_automations(sys.argv[2:])
    elif subcmd == "traces":
        cmd_traces()
    elif subcmd == "docs":
        cmd_docs()
    elif subcmd == "logs":
        cmd_logs()
    elif subcmd == "worktrees":
        cmd_worktrees(sys.argv[2:])
    elif subcmd == "merge":
        cmd_merge(sys.argv[2:])
    elif subcmd == "merges":
        cmd_merges(sys.argv[2:])
    elif subcmd == "daemon":
        import subprocess
        daemon_script = "/root/control-center/scripts/nexus_daemon.py"
        sub_args = sys.argv[2:] if len(sys.argv) > 2 else ["status"]
        subprocess.run([sys.executable, daemon_script] + sub_args)
    elif subcmd in ["provider", "providers"]:
        cmd_provider(sys.argv[2:])
    elif subcmd in ["mission", "missions"]:
        cmd_mission(sys.argv[2:])
    elif subcmd == "github":
        cmd_github(sys.argv[2:])
    elif subcmd in ["delivery", "deliveries"]:
        cmd_delivery(sys.argv[2:])
    elif subcmd in ["help", "--help", "-h"]:
        print("Usage: eco <status|daemon|delivery|github|mission|provider|worktrees|merge|merges|projects|agents|audit|test|security|deploy|approvals|brief|cost|secrets|jobs|docs|logs|traces|\"prompt\">")
    else:
        prompt = " ".join(sys.argv[1:])
        cmd_natural_language(prompt)

if __name__ == "__main__":
    main()
