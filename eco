    elif sub == "changelog" and len(args) > 1:
        mid = args[1]
        res = api_get(f"/missions/{mid}/changelog")
        print(f"\n{res.get('changelog')}")
    elif sub == "cancel" and len(args) > 1:
        mid = args[1]
        res = api_post(f"/missions/{mid}/cancel", {})
        print(f"\n{YELLOW}✓ Cancelled mission {mid} (State: {res.get('state')}){RESET}")
    elif sub == "resume" and len(args) > 1:
        mid = args[1]
        res = api_post(f"/missions/{mid}/resume", {})
        print(f"\n{GREEN}✓ Resumed mission {mid} (State: {res.get('state')}){RESET}")
    elif sub == "pause" and len(args) > 1:
        mid = args[1]
        res = api_post(f"/missions/{mid}/pause", {})
        print(f"\n{YELLOW}✓ Paused mission {mid} (State: {res.get('state')}){RESET}")
    elif sub == "retry" and len(args) > 1:
