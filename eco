        res = api_post("/agents/merge/evaluate", payload)
        print(f"\n{BOLD}Merge Evaluation: {source} -> {target}{RESET}")
        print(f"Mergeable: {GREEN if res.get('mergeable') else RED}{res.get('mergeable')}{RESET}")
        print(f"Fast-Forward: {res.get('is_fast_forward')}")
