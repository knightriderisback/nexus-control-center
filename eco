        scolor = GREEN if "PUBLISHED" in res.get("state", "") else RED
        print(f"\n{BOLD}Delivery ID:{RESET}       {CYAN}{res.get('delivery_id')}{RESET}")
        print(f"{BOLD}State:{RESET}             {scolor}{res.get('state')}{RESET}")
