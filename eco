        print(f"\n{BOLD}{'DELIVERY ID':<18} {'STATE':<22} {'PUBLISHED BRANCH':<30} {'PR'}{RESET}")
        print("=" * 80)
        for d in delivs:
            state = d.get("state", "UNKNOWN")
            scolor = GREEN if state == "COMPLETED" else (YELLOW if state in ["BRANCH_PUBLISHED", "PR_CREATED", "MERGE_READY", "APPROVAL_PENDING"] else RED)
            pr_str = f"#{d.get('pr_number')}" if d.get("pr_number") else "None"
            print(f"{CYAN}{d.get('delivery_id'):<18}{RESET} {scolor}{state:<22}{RESET} {d.get('published_branch', ''):<30} {pr_str}")
