            print(f"  • {CYAN}{n.get('id')}{RESET}: {BOLD}{n.get('title')}{RESET} -> {scolor}{n.get('status')}{RESET} ({n.get('assigned_agent')})")
    elif sub == "traceability" and len(args) > 1:
        mid = args[1]
        t = api_get(f"/missions/{mid}/traceability")
        s = t.get("summary", {})
        print(f"\n{BOLD}REQUIREMENT TRACEABILITY: {CYAN}{mid}{RESET} (Coverage: {s.get('coverage_percent')}%)")
        for link in t.get("links", []):
            print(f"  • [{link.get('requirement_id')}] -> {CYAN}{link.get('subtask_id')}{RESET} -> {link.get('explanation')}")
    elif sub == "acceptance" and len(args) > 1:
