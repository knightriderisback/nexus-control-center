            print(f"  • [{scolor}{ac.get('status')}{RESET}] {ac.get('criterion_id')}: {ac.get('description')}")
            if ac.get("evidence"):
                print(f"    Evidence: {ac.get('evidence')}")
    elif sub == "checkpoints" and len(args) > 1:
        mid = args[1]
        cps = api_get(f"/missions/{mid}/checkpoints")
        print(f"\n{BOLD}CHECKPOINTS ({cps.get('count')}): {CYAN}{mid}{RESET}")
        for cp in cps.get("checkpoints", []):
            print(f"  • {cp.get('checkpoint_id')} [{cp.get('timestamp')[:19]}] (State: {cp.get('state')})")
    else:
        print("Usage: eco mission [list | plan <goal> | run <goal> | status <id> | pause <id> | resume <id> | retry <id> | cancel <id> | graph <id> | traceability <id> | acceptance <id> | checkpoints <id> | changelog <id>]")

